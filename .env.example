# Open Notebook Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# REQUIRED
# =============================================================================

# Encryption key for storing API credentials securely in the database
# Change this to any secret string (minimum 16 characters recommended)
OPEN_NOTEBOOK_ENCRYPTION_KEY=change-me-to-a-secret-string
GATEWAY_RATE_LIMIT_TOKEN=change-me-to-an-independent-32-byte-random-secret

# Protect access to legal documents and chat history in production
OPEN_NOTEBOOK_PASSWORD=change-this-password

# Firebase Authentication (frontend public web configuration)
# Enable Google and Email/Password in Firebase Console > Authentication.
# The Admin SDK credential must never be placed in this file.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
# Backend-only. Use a file path, or inline JSON in a secret-managed environment.
# FIREBASE_SERVICE_ACCOUNT_JSON=C:\secrets\firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_FILE=C:\secrets\firebase-service-account.json
# or GOOGLE_APPLICATION_CREDENTIALS=C:\secrets\firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# =============================================================================
# DATABASE (Default values work with docker-compose.yml)
# =============================================================================

SURREAL_URL=ws://surrealdb:8000/rpc
# Set these only when the database runs in a local Docker container and the
# host Surreal CLI is a different major version.
SURREAL_EXPORT_DOCKER_CONTAINER=
SURREAL_EXPORT_DOCKER_ENDPOINT=http://localhost:8000
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

# =============================================================================
# OPTIONAL: AI Provider API Keys
# =============================================================================
# You can configure these via the UI (Settings → API Keys) or set them here
# UI configuration is recommended for better security and flexibility

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google AI
# GOOGLE_API_KEY=...

# Groq
# GROQ_API_KEY=gsk_...

# =============================================================================
# OPTIONAL: Advanced Configuration
# =============================================================================

# External API URL (for webhooks, callbacks, etc.)
# API_URL=http://localhost:5055

# Ollama endpoint (if running locally)
# OLLAMA_BASE_URL=http://ollama:11434

# Legal retrieval runtime: auto uses CUDA float16 when available and falls
# back to CPU float32. Set `cuda` only when CUDA is required.
# Keep user Q&A and read-only management projections independently routable.
# Retrieval V2 normally serves Q&A on 8766; the legacy service on 8765 remains
# the management/document projection and M2 rollback target.
LEGAL_SEARCH_URL=http://127.0.0.1:8766
LEGAL_MANAGEMENT_URL=http://127.0.0.1:8765
LEGAL_RETRIEVAL_V2_URL=http://127.0.0.1:8766
# Owner-directed R28 Q&A profile. R26 remains the documented rollback profile.
LEGAL_RETRIEVAL_PRODUCTION_PROFILE=r28-reconciled-v2
LEGAL_RETRIEVAL_V2_SELECTED_M5=v6r26
LEGAL_RETRIEVAL_V2_CANDIDATE_PROFILE=r28-final-catalog-coverage
LEGAL_RETRIEVAL_EXPECTED_RELEASE_ID=retrieval-v2-20260903-r28-reconciled-v2
LEGAL_RETRIEVAL_V2_PREWARM_FTS_FREQUENCY=true
LEGAL_RETRIEVAL_V2_PREWARM_ANN=true
LEGAL_RETRIEVAL_V2_PREWARM_LAW_CACHE=false
# Phase C vNext on an independent SHADOW collection only. Default false so
# live serving is unchanged. Never writes active_core_collection.txt.
LEGAL_RETRIEVAL_VNEXT_SHADOW=false
LEGAL_RETRIEVAL_VNEXT_SHADOW_COLLECTION=legal_chunks_retrieval_v2_current_kaggle_v6r1_shadow
LEGAL_EMBED_DEVICE=auto
LEGAL_RETRIEVAL_CACHE_TTL_SECONDS=300
LEGAL_RETRIEVAL_CACHE_MAX_ENTRIES=1024
# Optional learned reranker. It never downloads a model and remains disabled
# unless this flag is true and LEGAL_RERANKER_MODEL_PATH is a local directory.
LEGAL_LEARNED_RERANKER_ENABLED=false
# Vietnamese-first cross-encoder. Download/pin the artifact separately before
# enabling; request-time code never reaches Hugging Face or downloads weights.
# LEGAL_RERANKER_MODEL_ID=AITeamVN/Vietnamese_Reranker
# LEGAL_RERANKER_MODEL_LABEL=AITeamVN-Vietnamese_Reranker
# LEGAL_RERANKER_MODEL_PATH=D:/legal-chatbot-data/models/AITeamVN-Vietnamese_Reranker
LEGAL_RERANKER_DEVICE=auto
LEGAL_RERANKER_WINDOW=40
LEGAL_RERANKER_BATCH_SIZE=8
# Official BGE pair-scoring examples use a 512-token maximum. Lowering this is
# an explicit latency/coverage trade-off and must be benchmarked before use.
LEGAL_RERANKER_MAX_LENGTH=512
# In auto mode CUDA is used only when this much free VRAM is available.
LEGAL_RERANKER_MIN_CUDA_FREE_MB=2800
LEGAL_RERANKER_WEIGHT=1.0
# BGE-M3 is benchmark/shadow-only; this path never changes the active pointer.
# BGE_M3_MODEL_PATH=D:/legal-chatbot-data/models/bge-m3
LEGAL_LOCAL_FALLBACK_ENABLED=true
LEGAL_ASK_PROGRESS_ENABLED=false
# This release contains one public legal-answer runtime. Rollback by deploying
# the previous application image; do not stack role/phase answer flags.
LEGAL_DIRECT_RAG_TOTAL_TIMEOUT_SECONDS=75
LEGAL_SOFT_GROUNDING_ENABLED=true

LEGAL_RETRIEVAL_EXACT_ARTICLE_FASTPATH=true
CHAT_OPENROUTER_TOTAL_TIMEOUT_SECONDS=90
CHAT_OPENROUTER_GENERATION_TIMEOUT_SECONDS=75
CHAT_OTHER_MODEL_GENERATION_TIMEOUT_SECONDS=60
CHAT_MEMORY_V1_ENABLED=false
CHAT_MEMORY_V1_ROLES=
CHAT_MEMORY_SCOPE=conversation
CHAT_LONG_TERM_MEMORY_V1_ENABLED=false
CHAT_BEHAVIOR_POLICY_V1_ENABLED=true
CHAT_BEHAVIOR_POLICY_V1_ROLES=citizen,officer
# Adaptive, owner-scoped conversation orchestration. Disabled and unscoped by
# default; shadow mode records only route/context metadata and calls no model.
CHAT_CONVERSATIONAL_ORCHESTRATOR_V1_ENABLED=false
CHAT_CONVERSATIONAL_ORCHESTRATOR_V1_SHADOW=false
CHAT_CONVERSATIONAL_ORCHESTRATOR_V1_ROLES=
CHAT_LLM_ROUTER_V2_ENABLED=false
CHAT_LLM_ROUTER_V2_ROLES=
# Optional dedicated advisory model for ambiguous legal turns.  Keep the
# deterministic router authoritative; the model may only refine a fail-open.
CHAT_LLM_ROUTER_MODEL_ID=ollama:qwen2.5:0.5b
CHAT_LLM_ROUTER_DEDICATED_FOR_ADVISORY=false
# Direct RAG uses one deterministic authority. Balanced/deep may ask the same
# user-selected model for bounded advice only when the rule result is ambiguous.
CHAT_SELECTED_MODEL_PLANNER_MODE=ambiguous
CHAT_SELECTED_MODEL_PLANNER_TIMEOUT_SECONDS=4
CHAT_QUERY_REWRITE_TIMEOUT_SECONDS=4
CHAT_SELECTED_MODEL_QUERY_REWRITE_V1_ENABLED=true
CHAT_SELECTED_MODEL_QUERY_REWRITE_V1_ROLES=citizen,officer
# Unified rule-first router for Ask serving. Default on so meta / out-of-scope /
# document gates run before optional selected-model advice on ambiguous turns.
# Deterministic legal signals and access-control rules remain authoritative.
CHAT_UNIFIED_ROUTER_V1_ENABLED=true
CHAT_UNIFIED_ROUTER_V1_SHADOW=false
CHAT_CONTEXT_COMPACTION_V2_ENABLED=false
CHAT_CONTEXT_COMPACTION_V2_ROLES=
# LangGraph checkpoint for Chat tổng. The existing conversation store remains
# authoritative; this only persists owner/role-scoped thread state.
CHAT_LANGGRAPH_CHECKPOINT_V1_ENABLED=false
CHAT_LANGGRAPH_CHECKPOINT_V1_ROLES=
CHAT_LANGGRAPH_LLM_SUMMARY_V1_ENABLED=false
CHAT_LANGGRAPH_LLM_SUMMARY_V1_ROLES=
CHAT_LANGGRAPH_SUMMARY_MIN_NEW_MESSAGES=4
CHAT_LANGGRAPH_SUMMARY_MAX_MESSAGES_PER_CALL=80
CHAT_LANGGRAPH_SUMMARY_MAX_INPUT_CHARS=24000
CHAT_LANGGRAPH_SUMMARY_TIMEOUT_SECONDS=12
CHAT_ROUTING_MEMORY_V3_ENABLED=false
CHAT_ROUTING_MEMORY_V3_ROLES=
CHAT_FORM_RESOLVER_V3_ENABLED=false
CHAT_FORM_RESOLVER_V3_ROLES=
CHAT_QWEN_UI_V1_ENABLED=false
CHAT_QWEN_UI_V1_ROLES=
CHAT_QWEN_GATE_PASSED=false
NEXT_PUBLIC_CHAT_PRECISE_LEGAL_LINKS_V1_ENABLED=false
CHAT_CONTEXT_INPUT_TOKEN_BUDGET=16000
CHAT_CONTEXT_EVIDENCE_TOKEN_RESERVE=6000
CHAT_CONTEXT_OUTPUT_TOKEN_RESERVE=4096
CHAT_QWEN_NUM_CTX=4096
CHAT_QWEN_NUM_PREDICT=512
CHAT_QWEN_KEEP_ALIVE=10m
CHAT_QWEN_GENERATION_TIMEOUT_SECONDS=45
CHAT_DEEPSEEK_GENERATION_TIMEOUT_SECONDS=45
# Change this to the stronger installed Ollama tag when the local machine is
# upgraded (for example qwen3.5:4b). The UI still lists every installed tag.
OLLAMA_RECOMMENDED_MODEL=qwen2.5:3b
CHAT_QWEN_CONTEXT_MAX_CHARS=8000
CHAT_QWEN_WARMUP_ENABLED=false
# Browser ask budget. Keep within the backend total timeout so model switches
# fail clearly instead of leaving the user waiting indefinitely.
NEXT_PUBLIC_ASK_TIMEOUT_MS=120000
READINESS_MODEL_PROBE_ENABLED=true
READINESS_MODEL_PROBE_TIMEOUT_SECONDS=8
# Bound model readiness checks independently from answer generation.
LEGAL_AUDIT_WRITE_TIMEOUT_SECONDS=5
LEGAL_PHYSICAL_CITATIONS_ENABLED=false
LEGAL_AUDIT_CHAIN_ENABLED=false
LEGAL_AUDIT_CHECKPOINT_PRIVATE_KEY_FILE=
LEGAL_PROVIDER_DISCLOSURE_ENABLED=true
LEGAL_ADAPTIVE_HOP_ENABLED=false
VNLEGAL_LAL_MODEL_PATH=
VNLEGAL_LAL_MODEL_FINGERPRINT=
HUGGINGFACE_EMBEDDING_MODEL_PATH=
HUGGINGFACE_EMBEDDING_ALLOW_REMOTE=false
LEGAL_ASK_ROLE_ROLLOUT_ENFORCED=false
LEGAL_ASK_ROLE_ROLLOUT_STATE_PATH=data/pilot/ask_role_rollout.json
# Run the fail-closed official-form completion campaign at most once per date.
# This never creates a legal approval; Admin attestation remains mandatory.
LEGAL_FORM_COMPLETION_ENABLED=true

# Procedure/form governance stays compatibility-only until a separately
# approved PostgreSQL migration and active release pointer are in place.
FORM_GOVERNANCE_SOURCE=json_compat
FORM_GOVERNANCE_ROUTER_MODE=disabled
FORM_GOVERNANCE_SHADOW_RELEASE_ID=
FORM_GOVERNANCE_ROLLOUT_ROLES=citizen
FORM_RELEASE_VERIFY_REMOTE_SOURCES=false
# Leave blank for the repository default; Docker Compose sets /app/release-data.
FORM_RELEASE_ASSET_ROOT=

# Near-real-time legal validity synchronization. The default protects only
# documents with exact adverse official observations; unobserved/stale records
# remain warning-only until the separate strict release gate is approved.
LEGAL_VALIDITY_SYNC_ENABLED=true
LEGAL_VALIDITY_SYNC_INTERVAL_SECONDS=1800
LEGAL_VALIDITY_STALE_AFTER_SECONDS=21600
LEGAL_VALIDITY_SYNC_BATCH_SIZE=100
LEGAL_VALIDITY_SYNC_MAX_CONCURRENCY=3
LEGAL_VALIDITY_SYNC_RATE_LIMIT_SECONDS=1.0
LEGAL_VALIDITY_SYNC_MODE=protect

# Content processing
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=150

# Security
# OPEN_NOTEBOOK_PASSWORD=use-a-long-random-password

# For more configuration options, see:
# https://github.com/lfnovo/open-notebook/blob/main/docs/5-CONFIGURATION/environment-reference.md
# Candidate-first crawler detail extraction. Keep disabled until fixture and
# role-isolation gates pass; metadata-only discovery remains the fallback.
LEGAL_CRAWL_DETAIL_FETCH_ENABLED=false
# Keep false outside an explicitly controlled localhost corpus workflow.
LEGAL_ALLOW_LEGACY_DIRECT_IMPORT=false
LEGAL_ALLOW_INCREMENTAL_IMPORT=false
LEGAL_CHROMA_INCREMENTAL_COLLECTION=
# Maximum age used only to diagnose abandoned crawler runs. The first rollout
# reports stale records without mutating live history automatically.
LEGAL_CRAWL_STALE_AFTER_SECONDS=1800
# Hỏi nhanh khách vãng lai. Intent fast path remains fail-closed until an
# Admin-reviewed runtime catalog with official source references is released.
PROCEDURE_FAST_PATH_ENABLED=false
PROCEDURE_FAST_PATH_REQUIRE_SOURCE_URL=false
PROCEDURE_FAST_PATH_CATALOG=release-data/notebook_data/forms/managed_procedures_runtime_v1.json
PROCEDURE_INTENT_FAST_PATH_CATALOG=release-data/notebook_data/intents/managed_intents_runtime_v1.json
PROCEDURE_INTENT_FAST_PATH_REQUIRE_SOURCE=true
INTENT_FAST_PATH_ENABLED=false
PUBLIC_QUICK_CHAT_FAST_PATH_ENABLED=true
PUBLIC_QUICK_CHAT_LLM_FALLBACK=false
PUBLIC_QUICK_CHAT_PER_MINUTE=10
PUBLIC_QUICK_CHAT_PER_DAY=100
# Installation-wide load-shedding cap shared by local API workers/replicas.
PUBLIC_QUICK_CHAT_GLOBAL_PER_MINUTE=600
PUBLIC_QUICK_CHAT_IDEMPOTENCY_TTL_SECONDS=900
PUBLIC_QUICK_CHAT_QUOTA_PATH=runtime-data/public-quick-chat-quota.sqlite3
ADMIN_BACKUP_ROOT=D:/ChatBotLegal-backups
ADMIN_BACKUP_ALLOW_UNENCRYPTED=false
# Optional dedicated key. If empty, a namespaced key is derived from OPEN_NOTEBOOK_ENCRYPTION_KEY.
ADMIN_BACKUP_ENCRYPTION_KEY=
