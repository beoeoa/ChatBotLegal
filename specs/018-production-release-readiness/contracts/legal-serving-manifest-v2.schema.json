{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legal-serving-manifest-v2.schema.json",
  "title": "Legal serving manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_version", "dataset_version", "legal_as_of",
    "collection_name", "embedding_fingerprint", "document_count", "chunk_count",
    "visibility_policy", "documents", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "legal-serving-manifest-v2"},
    "manifest_version": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "legal_as_of": {"type": "string", "format": "date"},
    "collection_name": {"type": "string", "minLength": 1},
    "embedding_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "document_count": {"type": "integer", "minimum": 1},
    "chunk_count": {"type": "integer", "minimum": 1},
    "visibility_policy": {"const": "backend-role-v1"},
    "source_baseline_manifest_sha256": {"type": "string"},
    "generated_at": {"type": "string"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id", "law_number", "status", "domain", "visibility",
          "reason_kept", "score_components", "required_procedures", "chunk_ids",
          "source_id", "validity_confidence"
        ],
        "properties": {
          "document_id": {"type": "integer", "minimum": 1},
          "law_number": {"type": "string"},
          "status": {"type": "string"},
          "domain": {"type": "string"},
          "visibility": {"enum": ["public", "officer", "admin", "internal"]},
          "reason_kept": {"type": "array", "items": {"type": "string"}},
          "score_components": {"type": "object"},
          "required_procedures": {"type": "array"},
          "chunk_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          },
          "source_id": {"type": ["string", "integer", "null"]},
          "validity_confidence": {"type": ["number", "null"]}
        }
      }
    }
  }
}
