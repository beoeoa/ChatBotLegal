{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legal-serving-manifest-v3.schema.json",
  "title": "Legal serving manifest v3 with replayable vector provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_version",
    "dataset_version",
    "release_id",
    "chunk_store",
    "legal_as_of",
    "collection_name",
    "model_artifact_fingerprint",
    "tokenizer_fingerprint",
    "embedding_recipe_fingerprint",
    "passage_recipe_fingerprint",
    "splitter_fingerprint",
    "source_snapshot_fingerprint",
    "dependency_lock_fingerprint",
    "vector_content_fingerprint",
    "quality_policy_version",
    "visibility_policy",
    "inventory_document_count",
    "retrievable_document_count",
    "quarantined_document_count",
    "chunk_count",
    "vector_count",
    "documents",
    "generated_at",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "legal-serving-manifest-v3"},
    "manifest_version": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "minLength": 1},
    "chunk_store": {"const": "legal_chunk_revision_v2"},
    "legal_as_of": {"type": "string", "format": "date"},
    "collection_name": {"type": "string", "minLength": 1},
    "model_artifact_fingerprint": {"$ref": "#/$defs/sha256"},
    "tokenizer_fingerprint": {"$ref": "#/$defs/sha256"},
    "embedding_recipe_fingerprint": {"$ref": "#/$defs/sha256"},
    "passage_recipe_fingerprint": {"$ref": "#/$defs/sha256"},
    "splitter_fingerprint": {"$ref": "#/$defs/sha256"},
    "source_snapshot_fingerprint": {"$ref": "#/$defs/sha256"},
    "dependency_lock_fingerprint": {"$ref": "#/$defs/sha256"},
    "vector_content_fingerprint": {"$ref": "#/$defs/sha256"},
    "quality_policy_version": {"const": "legal-chunk-quality-v2"},
    "visibility_policy": {"const": "backend-role-v1"},
    "inventory_document_count": {"type": "integer", "minimum": 1},
    "retrievable_document_count": {"type": "integer", "minimum": 0},
    "quarantined_document_count": {"type": "integer", "minimum": 0},
    "chunk_count": {"type": "integer", "minimum": 1},
    "vector_count": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "law_number",
          "status",
          "domain",
          "visibility",
          "serving_state",
          "quarantine_reasons",
          "chunk_ids",
          "source_id",
          "validity_confidence"
        ],
        "properties": {
          "document_id": {"type": "integer", "minimum": 1},
          "law_number": {"type": "string"},
          "status": {"type": "string", "minLength": 1},
          "domain": {"type": ["string", "null"]},
          "visibility": {"enum": ["public", "officer", "admin", "internal"]},
          "serving_state": {"enum": ["retrievable", "quarantined"]},
          "quarantine_reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "chunk_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          },
          "source_id": {"type": ["string", "integer", "null"]},
          "validity_confidence": {"type": ["number", "null"]}
        },
        "allOf": [
          {
            "if": {"properties": {"serving_state": {"const": "retrievable"}}},
            "then": {
              "properties": {
                "chunk_ids": {"minItems": 1},
                "quarantine_reasons": {"maxItems": 0}
              }
            }
          },
          {
            "if": {"properties": {"serving_state": {"const": "quarantined"}}},
            "then": {
              "properties": {
                "chunk_ids": {"maxItems": 0},
                "quarantine_reasons": {"minItems": 1}
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
