{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retrieval-chunk-manifest-v2.schema.json",
  "title": "Legal Retrieval Release V2 chunk manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "release_id", "source_snapshot_sha256", "manifest_sha256",
    "approved", "legal_review_attestation", "chunk_count", "vector_count", "chunks"
  ],
  "properties": {
    "schema_version": {"const": "legal-retrieval-chunk-manifest-v2"},
    "release_id": {"type": "string", "minLength": 1},
    "source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "approved": {"type": "boolean"},
    "legal_review_attestation": {"type": "boolean"},
    "chunk_count": {"type": "integer", "minimum": 1},
    "vector_count": {"type": "integer", "minimum": 1},
    "chunks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/chunk"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "chunk": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "chunk_revision_id", "release_id", "document_id", "article_id", "structural_path",
        "content", "content_sha256", "embedding_text", "embedding_text_sha256",
        "source_content_sha256", "passage_sha256", "token_count",
        "eligible", "serving_state", "document_serving_state"
      ],
      "properties": {
        "chunk_revision_id": {"type": "string", "minLength": 1},
        "release_id": {"type": "string", "minLength": 1},
        "document_id": {"type": "integer", "minimum": 1},
        "article_id": {"type": "integer", "minimum": 1},
        "structural_path": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "embedding_text": {"type": "string", "minLength": 1},
        "embedding_text_sha256": {"$ref": "#/$defs/sha256"},
        "source_content_sha256": {"$ref": "#/$defs/sha256"},
        "passage_sha256": {"$ref": "#/$defs/sha256"},
        "token_count": {"type": "integer", "minimum": 1, "maximum": 512},
        "eligible": {"const": true},
        "serving_state": {"const": "retrievable"},
        "document_serving_state": {"enum": ["current_retrievable", "historical_only"]}
      }
    }
  }
}
