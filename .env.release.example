# Generate .env.release with scripts/prepare_release_env.ps1 before starting.
# Never commit the populated .env.release file.
PILOT_HOSTNAME=chatbotlegal.local
OPEN_NOTEBOOK_ADMIN_PASSWORD=change-this-admin-password
OPEN_NOTEBOOK_ENCRYPTION_KEY=replace-with-a-long-random-secret
GATEWAY_RATE_LIMIT_TOKEN=replace-with-an-independent-32-byte-random-secret
SURREAL_PASSWORD=replace-with-a-database-password
FIREBASE_PROJECT_ID=chatbotle-2b109
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Backend only; mount the service-account file and point this at its container path.
# FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# Inline JSON is also supported when supplied by a secret manager.
# Frontend NEXT_PUBLIC_FIREBASE_* values must be supplied at frontend build time.
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
LEGAL_POSTGRES_PASSWORD=change-this-postgres-password
VNLEGAL_LAL_MODEL_FINGERPRINT=29020cd8c81d5439420992fc7e8c08eb16fa2883f4fefadb1e6bb4918116b9aa
LEGAL_SECTION_GROUNDING_ENABLED=false
# Owner-directed R28 production profile. R26 remains the documented rollback.
LEGAL_RETRIEVAL_PRODUCTION_PROFILE=r28-reconciled-v2
LEGAL_RETRIEVAL_V2_SELECTED_M5=v6r26
LEGAL_RETRIEVAL_V2_CANDIDATE_PROFILE=r28-final-catalog-coverage
LEGAL_RETRIEVAL_EXPECTED_RELEASE_ID=retrieval-v2-20260903-r28-reconciled-v2
LEGAL_RETRIEVAL_V2_PREWARM_FTS_FREQUENCY=true
LEGAL_RETRIEVAL_V2_PREWARM_ANN=true
LEGAL_RETRIEVAL_V2_PREWARM_LAW_CACHE=false
LEGAL_EMBED_DEVICE=cpu
# One public answer runtime; rollback is the previous application release.
LEGAL_DIRECT_RAG_TOTAL_TIMEOUT_SECONDS=75
LEGAL_SOFT_GROUNDING_ENABLED=true

LEGAL_RETRIEVAL_EXACT_ARTICLE_FASTPATH=true
CHAT_MEMORY_V1_ENABLED=false
CHAT_MEMORY_V1_ROLES=
CHAT_MEMORY_SCOPE=conversation
CHAT_LONG_TERM_MEMORY_V1_ENABLED=false
CHAT_BEHAVIOR_POLICY_V1_ENABLED=true
CHAT_BEHAVIOR_POLICY_V1_ROLES=citizen,officer
CHAT_CONVERSATIONAL_ORCHESTRATOR_V1_ENABLED=false
CHAT_CONVERSATIONAL_ORCHESTRATOR_V1_SHADOW=false
CHAT_CONVERSATIONAL_ORCHESTRATOR_V1_ROLES=
CHAT_LLM_ROUTER_V2_ENABLED=false
CHAT_LLM_ROUTER_V2_ROLES=
# Optional dedicated advisory model for ambiguous legal turns.
CHAT_LLM_ROUTER_MODEL_ID=ollama:qwen2.5:0.5b
CHAT_LLM_ROUTER_DEDICATED_FOR_ADVISORY=false
CHAT_SELECTED_MODEL_PLANNER_MODE=ambiguous
CHAT_SELECTED_MODEL_PLANNER_TIMEOUT_SECONDS=4
CHAT_QUERY_REWRITE_TIMEOUT_SECONDS=4
CHAT_SELECTED_MODEL_QUERY_REWRITE_V1_ENABLED=true
CHAT_SELECTED_MODEL_QUERY_REWRITE_V1_ROLES=citizen,officer

# Release gate: unified deterministic routing is authoritative. Balanced/deep
# can use bounded advice from the same model selected for the answer.
CHAT_UNIFIED_ROUTER_V1_ENABLED=true
CHAT_CONTEXT_COMPACTION_V2_ENABLED=false
CHAT_CONTEXT_COMPACTION_V2_ROLES=
CHAT_ROUTING_MEMORY_V3_ENABLED=false
CHAT_ROUTING_MEMORY_V3_ROLES=
CHAT_FORM_RESOLVER_V3_ENABLED=false
CHAT_FORM_RESOLVER_V3_ROLES=
CHAT_QWEN_UI_V1_ENABLED=false
CHAT_QWEN_UI_V1_ROLES=
CHAT_QWEN_GATE_PASSED=false
NEXT_PUBLIC_CHAT_PRECISE_LEGAL_LINKS_V1_ENABLED=false
CHAT_CONTEXT_INPUT_TOKEN_BUDGET=16000
CHAT_CONTEXT_EVIDENCE_TOKEN_RESERVE=6000
CHAT_CONTEXT_OUTPUT_TOKEN_RESERVE=4096
CHAT_QWEN_NUM_CTX=8192
CHAT_QWEN_NUM_PREDICT=768
CHAT_QWEN_KEEP_ALIVE=10m
CHAT_QWEN_GENERATION_TIMEOUT_SECONDS=18
CHAT_DEEPSEEK_GENERATION_TIMEOUT_SECONDS=18
CHAT_QWEN_CONTEXT_MAX_CHARS=8000
CHAT_QWEN_WARMUP_ENABLED=false
LEGAL_RETRIEVAL_BATCH_CACHE_TTL_SECONDS=30
LEGAL_RETRIEVAL_BATCH_CACHE_MAX_ENTRIES=256
NEXT_PUBLIC_ASK_SSE_ENABLED=false
NEXT_PUBLIC_ASK_TIMEOUT_MS=120000
FORM_GOVERNANCE_SOURCE=json_compat
FORM_GOVERNANCE_ROUTER_MODE=disabled
FORM_GOVERNANCE_SHADOW_RELEASE_ID=
FORM_GOVERNANCE_ROLLOUT_ROLES=citizen
FORM_RELEASE_VERIFY_REMOTE_SOURCES=false
FORM_RELEASE_ASSET_ROOT=/app/release-data
LEGAL_ANSWER_OPTIMIZED_PROFILE_ENABLED=false
LEGAL_ANSWER_OPTIMIZED_PROFILE_ROLES=citizen,officer
LEGAL_ANSWER_OPTIMIZED_PROFILE_CONTEXT_BENCHMARK=false
LEGAL_ANSWER_OPTIMIZED_PROFILE_ENFORCED=false
LEGAL_ANSWER_OPTIMIZED_PROFILE_STATE_PATH=data/pilot/ask_optimized_profile_rollout.json
# Guest quick-chat release gate. Keep intent fast path disabled until its
# answer catalog has passed source/effectivity review and release validation.
PROCEDURE_FAST_PATH_ENABLED=false
PROCEDURE_FAST_PATH_REQUIRE_SOURCE_URL=true
PROCEDURE_FAST_PATH_CATALOG=/app/data/forms/managed_procedures_runtime_v1.json
PROCEDURE_INTENT_FAST_PATH_CATALOG=/app/data/intents/managed_intents_runtime_v1.json
PROCEDURE_INTENT_FAST_PATH_REQUIRE_SOURCE=true
INTENT_FAST_PATH_ENABLED=false
PUBLIC_QUICK_CHAT_FAST_PATH_ENABLED=true
PUBLIC_QUICK_CHAT_LLM_FALLBACK=false
PUBLIC_QUICK_CHAT_PER_MINUTE=10
PUBLIC_QUICK_CHAT_PER_DAY=100
PUBLIC_QUICK_CHAT_GLOBAL_PER_MINUTE=600
PUBLIC_QUICK_CHAT_IDEMPOTENCY_TTL_SECONDS=900
PUBLIC_QUICK_CHAT_QUOTA_PATH=/app/runtime-data/public-quick-chat-quota.sqlite3
ADMIN_BACKUP_ROOT=/backups
SURREAL_EXPORT_DOCKER_CONTAINER=
SURREAL_EXPORT_DOCKER_ENDPOINT=http://localhost:8000
ADMIN_BACKUP_ALLOW_UNENCRYPTED=false
# Optional dedicated key. If empty, a namespaced key is derived from OPEN_NOTEBOOK_ENCRYPTION_KEY.
ADMIN_BACKUP_ENCRYPTION_KEY=
