-- Logical migration 48 (file 49; migration 48 is reserved for opt-in chat
-- memory). Store Ask source snapshots as typed objects instead of an
-- untyped array, which SurrealDB 2.6 coerces to [] on write.
REMOVE FIELD IF EXISTS sources.* ON TABLE user_ask_history;
DEFINE FIELD OVERWRITE sources ON TABLE user_ask_history TYPE option<array<object>> FLEXIBLE;
