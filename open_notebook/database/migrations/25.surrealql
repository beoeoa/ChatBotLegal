-- Migration 25: define nested AI candidate assessment fields for SCHEMAFULL records
DEFINE FIELD IF NOT EXISTS ai_assessment.domain ON TABLE legal_crawl_candidate TYPE string;
DEFINE FIELD IF NOT EXISTS ai_assessment.scope ON TABLE legal_crawl_candidate TYPE string;
