ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE} AS retrieval-base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TRANSFORMERS_OFFLINE=1 \
    HF_HUB_OFFLINE=1 \
    LEGAL_DATA_ROOT=/data/legal \
    LEGAL_CHROMA_PATH=/data/legal/chroma_store \
    LEGAL_SEARCH_PORT=8765

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /root/.ssh \
    && chmod 0700 /root/.ssh

FROM retrieval-base AS retrieval-cpu-deps
COPY requirements/legal-retrieval-docker.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

FROM retrieval-base AS retrieval-cuda-deps
COPY requirements/legal-retrieval-cu126.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

FROM retrieval-cpu-deps AS retrieval-cpu
COPY scripts/legal_search_server.py /app/scripts/legal_search_server.py
COPY scripts/legal_search_v2_server.py /app/scripts/legal_search_v2_server.py
COPY scripts/legal_retrieval_cache.py /app/scripts/legal_retrieval_cache.py
COPY scripts/kaggle_retrieval_v2_benchmark_common.py /app/scripts/kaggle_retrieval_v2_benchmark_common.py
COPY scripts/simple_encoder.py /app/scripts/simple_encoder.py
COPY scripts/verify_core_288_release.py /app/scripts/verify_core_288_release.py
COPY scripts/render_retrieval_entrypoint.py /app/scripts/render_retrieval_entrypoint.py
COPY api /app/api
COPY open_notebook /app/open_notebook
COPY config /app/config
COPY frontend/src/lib/data/commune-catalog.json /app/frontend/src/lib/data/commune-catalog.json
EXPOSE 8765
HEALTHCHECK --interval=15s --timeout=5s --retries=20 CMD curl --fail --silent http://localhost:8765/health || exit 1
CMD ["uvicorn", "scripts.legal_search_server:app", "--host", "0.0.0.0", "--port", "8765"]

FROM retrieval-cuda-deps AS retrieval-cuda
COPY scripts/legal_search_server.py /app/scripts/legal_search_server.py
COPY scripts/legal_search_v2_server.py /app/scripts/legal_search_v2_server.py
COPY scripts/legal_retrieval_cache.py /app/scripts/legal_retrieval_cache.py
COPY scripts/kaggle_retrieval_v2_benchmark_common.py /app/scripts/kaggle_retrieval_v2_benchmark_common.py
COPY scripts/simple_encoder.py /app/scripts/simple_encoder.py
COPY api /app/api
COPY open_notebook /app/open_notebook
COPY config /app/config
COPY frontend/src/lib/data/commune-catalog.json /app/frontend/src/lib/data/commune-catalog.json
EXPOSE 8765
HEALTHCHECK --interval=15s --timeout=5s --retries=20 CMD curl --fail --silent http://localhost:8765/health || exit 1
CMD ["uvicorn", "scripts.legal_search_server:app", "--host", "0.0.0.0", "--port", "8765"]

# Plain `docker build` remains CPU-safe; release compose selects a target explicitly.
FROM retrieval-cpu AS retrieval-default
